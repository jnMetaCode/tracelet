{
  "name": "@jnmetacode/tracelet",
  "version": "0.3.0",
  "description": "Local DevTools for AI agents: watch every LLM and tool call live, and diff two runs step by step. Any framework via OpenTelemetry, one-liners for the Vercel AI SDK and LangChain.js. Zero dependencies, 100% local.",
  "type": "module",
  "bin": {
    "tracelet": "src/cli.js"
  },
  "main": "./src/server.js",
  "exports": {
    ".": "./src/server.js",
    "./ai-sdk": "./src/ai-sdk.js",
    "./ai-sdk/register": "./src/ai-sdk-register.js",
    "./package.json": "./package.json",
    "./langchain": "./src/langchain.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "dev": "node src/cli.js --port 4318",
    "test": "node --test test/run.js",
    "demo": "node examples/demo.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jnMetaCode/tracelet.git"
  },
  "homepage": "https://github.com/jnMetaCode/tracelet#readme",
  "bugs": {
    "url": "https://github.com/jnMetaCode/tracelet/issues"
  },
  "files": [
    "src",
    "public",
    "examples",
    "README.md"
  ],
  "keywords": [
    "ai",
    "agents",
    "observability",
    "opentelemetry",
    "otel",
    "tracing",
    "llm",
    "devtools",
    "local-first",
    "debugging",
    "langchain",
    "vercel-ai-sdk",
    "langgraph",
    "ai-sdk",
    "compare",
    "diff"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {}
}
